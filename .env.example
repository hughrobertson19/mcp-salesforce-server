# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# These come from a Salesforce Connected App with OAuth enabled and
# "Client Credentials Flow" turned on (Setup > App Manager > your app > Edit Policies),
# with a "Run As" user configured. See README.md for the full setup walkthrough.

# Consumer Key from the Connected App.
SF_CLIENT_ID=

# Consumer Secret from the Connected App.
SF_CLIENT_SECRET=

# Your org's login/My Domain URL, no trailing slash.
# Production/Developer Edition orgs: https://login.salesforce.com
# Sandboxes: https://test.salesforce.com
# Or your org's My Domain URL, e.g. https://your-domain.my.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce REST API version. Optional — defaults to 61.0.
# SF_API_VERSION=61.0

# Directory for the proposal store and audit log. Optional — defaults to ./data.
# DATA_DIR=./data

# How long a proposed update stays valid before confirm_update rejects it as expired.
# Optional — defaults to 15.
# PROPOSAL_TTL_MINUTES=15
